# Copy to .env.local and fill in values for local development.
# All NEXT_PUBLIC_* vars are read by the Next.js dev server at startup —
# restart the server after changing them.

# ── Job board proxy ──────────────────────────────────────────────────────────
# Required. app/api/jobs/route.ts throws at startup if this is absent.
# Points to external/jobflix-backend-js (run: cd external/jobflix-backend-js && npx nodemon server.js)
NEXT_PUBLIC_API_URL=http://localhost:9001/api

# ── Portfolio extraction (NVIDIA NIM step in the extract-portfolio pipeline) ──
# Required. Portfolio extraction hard-fails if PORT_API_KEY is absent.
# No fallback to GEMINI_API_KEY — portfolio and resume flows are fully isolated.
PORT_API_KEY=
PORT_MODEL=openai/gpt-oss-20b

# ── Auth / general backend ───────────────────────────────────────────────────
# Used by next.config.ts fallback rewrite for all non-job /api/* routes.
NEXT_PUBLIC_JOBFILX_APIURL=http://localhost:7005/api
NEXT_PUBLIC_JOBFILX_APIURL_BASE=http://localhost:7005
NEXT_PUBLIC_AUTH_VIEW=http://localhost:3001
NEXT_PUBLIC_AUTH_CLIENT_URL=http://localhost:3001
NEXT_PUBLIC_JOBFLIX_VIEW=http://localhost:3000
NEXT_PUBLIC_ROOT_URL=http://localhost:3000
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA





